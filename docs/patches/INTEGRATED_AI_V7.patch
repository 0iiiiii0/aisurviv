+export interface HealSafetyContext {
+    health: number;
+    enemyDistance: number;
+    enemyHasLineOfSight: boolean;
+    inHardCover: boolean;
+    indoors: boolean;
+    outsideGas: boolean;
+    underAirstrike: boolean;
+    ballisticPressure: boolean;
+    millisecondsSinceDamage: number;
+    actionAlreadyActive?: boolean;
+}
+
+export interface HealSafetyDecision {
+    canHeal: boolean;
+    mustSeekCover: boolean;
+    cancelActiveAction: boolean;
+    reason:
+        | "safe"
+        | "gas"
+        | "airstrike"
+        | "enemy-line-of-sight"
+        | "point-blank-threat"
+        | "recent-damage"
+        | "ballistic-pressure"
+        | "needs-cover";
+}
+
+/**
+ * Healing is a committed, stationary action. During combat it is permitted
+ * only after line-of-sight has been broken by hard cover or a sound indoor
+ * position and after a short no-damage window. Critical HP increases urgency to
+ * reach cover; it does not allow face-tanking a medkit in front of an enemy.
+ */
+export function assessHealSafety(context: HealSafetyContext): HealSafetyDecision {
+    const protectedPosition = context.inHardCover || context.indoors;
+    const recentDamageLimit = context.actionAlreadyActive ? 220 : 850;
+    const combatPressure =
+        context.enemyDistance < 72 ||
+        context.enemyHasLineOfSight ||
+        context.ballisticPressure ||
+        context.millisecondsSinceDamage < 3600;
+
+    if (context.outsideGas) {
+        return {
+            canHeal: false,
+            mustSeekCover: false,
+            cancelActiveAction: true,
+            reason: "gas",
+        };
+    }
+    if (context.underAirstrike) {
+        return {
+            canHeal: false,
+            mustSeekCover: false,
+            cancelActiveAction: true,
+            reason: "airstrike",
+        };
+    }
+    if (context.enemyDistance < 8) {
+        return {
+            canHeal: false,
+            mustSeekCover: true,
+            cancelActiveAction: true,
+            reason: "point-blank-threat",
+        };
+    }
+    if (context.enemyHasLineOfSight) {
+        return {
+            canHeal: false,
+            mustSeekCover: true,
+            cancelActiveAction: true,
+            reason: "enemy-line-of-sight",
+        };
+    }
+    if (context.millisecondsSinceDamage < recentDamageLimit) {
+        return {
+            canHeal: false,
+            mustSeekCover: combatPressure,
+            cancelActiveAction: Boolean(context.actionAlreadyActive),
+            reason: "recent-damage",
+        };
+    }
+    if (context.ballisticPressure && !protectedPosition) {
+        return {
+            canHeal: false,
+            mustSeekCover: true,
+            cancelActiveAction: Boolean(context.actionAlreadyActive),
+            reason: "ballistic-pressure",
+        };
+    }
+    if (combatPressure && !protectedPosition) {
+        return {
+            canHeal: false,
+            mustSeekCover: true,
+            cancelActiveAction: Boolean(context.actionAlreadyActive),
+            reason: "needs-cover",
+        };
+    }
+    return {
+        canHeal: true,
+        mustSeekCover: false,
+        cancelActiveAction: false,
+        reason: "safe",
+    };
+}
