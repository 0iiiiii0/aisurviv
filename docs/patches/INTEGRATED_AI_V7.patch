+export interface PrecisionStopContext {
+    stopToShoot: boolean;
+    meleeWeapon: boolean;
+    targetDistance: number;
+    weaponRange: number;
+    lineClear: boolean;
+    healthSafe: boolean;
+    recentlyDamaged: boolean;
+    underAirstrike: boolean;
+    nearbyEnemyCount: number;
+}
+
+export interface TriggerContext {
+    duelMode: boolean;
+    reactionReady: boolean;
+    inRange: boolean;
+    lineClear: boolean;
+    ammoReady: boolean;
+    shootConfidence: number;
+    randomRoll: number;
+}
+
+/**
+ * A precision weapon may only root the bot when a real shot is currently
+ * possible. This prevents the 1v1 failure where a bot selected a long-range
+ * weapon, aimed at the opponent, stopped moving, but remained outside the
+ * weapon's effective range forever.
+ */
+export function shouldStopForPrecisionShot(context: PrecisionStopContext): boolean {
+    return Boolean(
+        context.stopToShoot &&
+            !context.meleeWeapon &&
+            context.targetDistance <= Math.max(1, context.weaponRange) &&
+            context.lineClear &&
+            context.healthSafe &&
+            !context.recentlyDamaged &&
+            !context.underAirstrike &&
+            context.nearbyEnemyCount === 0,
+    );
+}
+
+/**
+ * Duel mode uses deterministic trigger discipline once reaction time, range,
+ * line-of-sight, and ammunition checks pass. Aim jitter and weapon cooldowns
+ * still keep the result human-like, but a bad random streak can no longer make
+ * the bot stare at a visible opponent without firing.
+ */
+export function shouldPullTrigger(context: TriggerContext): boolean {
+    if (
+        !context.reactionReady ||
+        !context.inRange ||
+        !context.lineClear ||
+        !context.ammoReady
+    ) {
+        return false;
+    }
+    if (context.duelMode) return true;
+    return context.randomRoll <= Math.max(0, Math.min(1, context.shootConfidence));
+}
