+export interface FactionUnarmedCombatInput {
+    factionMode: boolean;
+    usableGunCount: number;
+    enemyDistance: number;
+    enemyUsesMelee: boolean;
+    enemyMeleeReach: number;
+}
+
+/**
+ * In faction mode an AI without a usable firearm should rotate to weapons,
+ * not volunteer for a fist fight. Only an attacker already inside immediate
+ * melee range is allowed to hard-interrupt the weapon search.
+ */
+export function factionUnarmedCombatPolicy(input: FactionUnarmedCombatInput): {
+    prioritizeWeaponSearch: boolean;
+    immediateMeleeThreat: boolean;
+    allowCombat: boolean;
+} {
+    const prioritizeWeaponSearch = input.factionMode && input.usableGunCount <= 0;
+    const immediateMeleeThreat =
+        input.enemyUsesMelee &&
+        input.enemyMeleeReach > 0 &&
+        input.enemyDistance <= input.enemyMeleeReach;
+    return {
+        prioritizeWeaponSearch,
+        immediateMeleeThreat,
+        allowCombat: !prioritizeWeaponSearch || immediateMeleeThreat,
+    };
+}
+
+export const lootSourceMemoryMs = (sourceTier: string): number =>
+    sourceTier.includes("airdrop") ? 14_000 : 5_200;
+
+export const lootSourceAssociationRadius = (sourceTier: string): number =>
+    sourceTier.includes("airdrop") ? 24 : 14;
+
+export interface EmptyFlareDropState {
+    key: string;
+    retryAt: number;
+}
+
+/** Prevents the empty flare gun branch from stalling movement every AI tick. */
+export function emptyFlareDropDecision(
+    current: EmptyFlareDropState,
+    flareKey: string,
+    timestamp: number,
+): { shouldDrop: boolean; next: EmptyFlareDropState } {
+    if (!flareKey) return { shouldDrop: false, next: { key: "", retryAt: 0 } };
+    if (current.key === flareKey && timestamp < current.retryAt) {
+        return { shouldDrop: false, next: current };
+    }
+    return {
+        shouldDrop: true,
+        next: { key: flareKey, retryAt: timestamp + 2200 },
+    };
+}
