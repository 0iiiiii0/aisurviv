+
+const previous = JSON.parse(JSON.stringify(Config.botAutoFill)) as typeof Config.botAutoFill;
+try {
+    Config.botAutoFill.defaultJoinIntervalMs = 3500;
+    Config.botAutoFill.modeOverrides = {
+        [getBotAutoFillModeKey("main", TeamMode.Solo)]: {
+            joinIntervalMs: 1250,
+            botLimit: 7,
+            targetPlayerCount: 11,
+        },
+        [getBotAutoFillModeKey("faction", TeamMode.Squad)]: {
+            joinIntervalMs: 5000,
+            botLimit: 24,
+        },
+    };
+
+    const solo = getBotAutoFillPolicy("main", TeamMode.Solo);
+    assert.ok(solo);
+    assert.equal(solo.joinIntervalMs, 1250);
+    assert.equal(solo.maxBotCount, 7);
+    assert.equal(solo.targetPlayerCount, 11);
+
+    const duo = getBotAutoFillPolicy("main", TeamMode.Duo);
+    assert.ok(duo);
+    assert.equal(duo.joinIntervalMs, 3500);
+    assert.equal(duo.maxBotCount, 20);
+    assert.equal(duo.targetPlayerCount, 20);
+
+    const faction = getBotAutoFillPolicy("faction", TeamMode.Squad);
+    assert.ok(faction);
+    assert.equal(faction.joinIntervalMs, 5000);
+    assert.equal(faction.factionBotCapTotal, 24);
+    assert.equal(faction.factionBotCapPerTeam, 12);
+
+    Config.botAutoFill.modeOverrides[getBotAutoFillModeKey("faction", TeamMode.Squad)] = {
+        joinIntervalMs: 800,
+        botLimit: 25,
+    };
+    const normalizedFaction = getBotAutoFillPolicy("faction", TeamMode.Squad);
+    assert.equal(normalizedFaction?.factionBotCapTotal, 24);
+    assert.equal(normalizedFaction?.factionBotCapPerTeam, 12);
+    console.log("Bot auto-fill config smoke test passed: live per-mode cadence, ordinary AI caps/targets, and balanced faction total limits.");
+} finally {
+    Config.botAutoFill.defaultJoinIntervalMs = previous.defaultJoinIntervalMs;
+    Config.botAutoFill.modeOverrides = previous.modeOverrides;
+}
