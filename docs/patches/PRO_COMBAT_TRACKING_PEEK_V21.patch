+    private stableCombatAimDirection(
+        myPos: Vec2,
+        enemyId: number,
+        enemyPos: Vec2,
+        memory: PlayerMemory | undefined,
+        projectileSpeed: number,
+        targetDistance: number,
+        leadScale: number,
+        movingPenalty: number,
+        timestamp: number,
+    ): { direction: Vec2; point: Vec2 } {
+        const targetChanged = this.trackedAimEnemyId !== enemyId;
+        const prediction = predictInterceptPoint({
+            shooterPos: myPos,
+            targetPos: enemyPos,
+            targetVelocity: memory?.velocity ?? v2.create(0, 0),
+            targetAcceleration: memory?.acceleration ?? v2.create(0, 0),
+            projectileSpeed,
+            leadFactor: this.profile.leadFactor * clamp(leadScale, 0.72, 1.28),
+            reactionSeconds: this.profile.reactionMs / 1000 * 0.28,
+            maxLeadSeconds: targetDistance <= 14 ? 0.19 : targetDistance <= 38 ? 0.42 : 0.72,
+        });
+        const rawPoint = v2.create(prediction.point.x, prediction.point.y);
+        if (targetChanged || timestamp - this.trackedAimUpdatedAt > 700) {
+            this.trackedAimEnemyId = enemyId;
+            this.trackedAimPoint = rawPoint;
+            this.trackedAimVelocity = memory?.velocity ?? v2.create(0, 0);
+        } else {
+            const response = targetDistance <= 14
+                ? this.difficulty === "pro" ? 0.84 : 0.72
+                : targetDistance >= 42
+                  ? this.difficulty === "pro" ? 0.62 : 0.48
+                  : 0.68;
+            this.trackedAimPoint = lerp(this.trackedAimPoint, rawPoint, response);
+            this.trackedAimVelocity = lerp(
+                this.trackedAimVelocity,
+                memory?.velocity ?? v2.create(0, 0),
+                0.55,
+            );
+        }
+        this.trackedAimUpdatedAt = timestamp;
+
+        if (timestamp >= this.stableAimNoiseUntil || targetChanged) {
+            const holdMs = this.difficulty === "pro" ? 170 : this.difficulty === "hard" ? 260 : 390;
+            const baseJitter = config.mapAi
+                ? this.mapNavigator.aimJitter(this.profile.aimJitterRad)
+                : this.profile.aimJitterRad;
+            this.stableAimNoiseRad = util.random(-baseJitter, baseJitter) * movingPenalty;
+            this.stableAimNoiseUntil = timestamp + holdMs;
+        }
+        const direct = normalize(sub(this.trackedAimPoint, myPos));
+        return {
+            direction: fromAngle(angleOf(direct) + this.stableAimNoiseRad),
+            point: this.trackedAimPoint,
+        };
+    }
