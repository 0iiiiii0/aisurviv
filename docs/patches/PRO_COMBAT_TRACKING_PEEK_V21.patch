+    private chooseCombatCover(
+        myPos: Vec2,
+        enemyPos: Vec2,
+        enemyId: number,
+    ): CombatCoverChoice | null {
+        let best: CombatCoverChoice | null = null;
+        for (const object of this.spatialGrid.queryRadius(myPos, 22)) {
+            if (object.__type !== ObjectType.Obstacle || object.data.dead) continue;
+            if (Number(object.data.layer ?? 0) !== this.myLayer()) continue;
+            if (object.data.isDoor) continue;
+            const type = String(object.data.type ?? "").toLowerCase();
+            if (/bush|grass|smoke|window|river|water|stair|decal|floor/.test(type)) continue;
+            const pos = object.data.pos as Vec2 | undefined;
+            if (!pos) continue;
+            const radius = this.obstacleRadius(object);
+            if (radius < 0.72) continue;
+            const geometry = coverGeometry({
+                obstaclePos: pos,
+                obstacleRadius: radius,
+                enemyPos,
+                playerRadius: 0.72,
+                peekPadding: this.difficulty === "pro" ? 0.34 : 0.5,
+            });
+            const anchor = v2.create(geometry.anchor.x, geometry.anchor.y);
+            const leftPeek = v2.create(geometry.leftPeek.x, geometry.leftPeek.y);
+            const rightPeek = v2.create(geometry.rightPeek.x, geometry.rightPeek.y);
+            if (this.isPointOutsideMap(anchor) || !this.pointInsideCurrentGas(anchor, 0.7)) continue;
+            if (!this.hasClearResourcePath(myPos, anchor, object.__id)) continue;
+            if (!obstacleBlocksBody(enemyPos, anchor, pos, radius, 0.72)) continue;
+            if (this.hasLineOfSight(enemyPos, anchor, enemyId)) continue;
+
+            const leftValid =
+                !this.isPointOutsideMap(leftPeek) &&
+                this.pointInsideCurrentGas(leftPeek, 0.5) &&
+                this.hasClearResourcePath(anchor, leftPeek, object.__id) &&
+                this.hasVisualLineOfSight(leftPeek, enemyPos, enemyId);
+            const rightValid =
+                !this.isPointOutsideMap(rightPeek) &&
+                this.pointInsideCurrentGas(rightPeek, 0.5) &&
+                this.hasClearResourcePath(anchor, rightPeek, object.__id) &&
+                this.hasVisualLineOfSight(rightPeek, enemyPos, enemyId);
+            if (!leftValid && !rightValid) continue;
+
+            const currentCoverBonus = object.__id === this.combatCoverObstacleId ? 34 : 0;
+            const travel = distance(myPos, anchor);
+            const enemyDistance = distance(enemyPos, anchor);
+            const sizeBonus = Math.min(28, radius * 11);
+            const twoSidedBonus = leftValid && rightValid ? 14 : 0;
+            const score = 140 + sizeBonus + twoSidedBonus + currentCoverBonus - travel * 5.2 + Math.min(16, enemyDistance * 0.18);
+            if (!best || score > best.score) {
+                best = {
+                    obstacle: object,
+                    anchor,
+                    leftPeek: leftValid ? leftPeek : rightPeek,
+                    rightPeek: rightValid ? rightPeek : leftPeek,
+                    score,
+                };
+            }
+        }
+        return best;
+    }
